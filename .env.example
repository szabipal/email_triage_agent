EMAIL_AGENT_ENVIRONMENT=development
EMAIL_AGENT_DATABASE_URL=sqlite:///./data/email_agent.db
EMAIL_AGENT_VECTOR_STORE_PATH=./data/chroma
EMAIL_AGENT_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

EMAIL_AGENT_LLM_PROVIDER=fake
EMAIL_AGENT_LLM_MODEL=fake-llm
EMAIL_AGENT_LLM_MAX_BODY_CHARS=8000
# EMAIL_AGENT_LLM_API_KEY=

EMAIL_AGENT_EMBEDDING_PROVIDER=fake
EMAIL_AGENT_EMBEDDING_MODEL=fake-embedding
EMAIL_AGENT_EMBEDDING_DIMENSION=8
# EMAIL_AGENT_EMBEDDING_API_KEY=

EMAIL_AGENT_CALENDAR_PROVIDER=fake
EMAIL_AGENT_CALENDAR_EXECUTION_ENABLED=false
# EMAIL_AGENT_GOOGLE_CALENDAR_CREDENTIALS_PATH=

# Gmail sync uses a Google OAuth desktop client JSON file.
# EMAIL_AGENT_GMAIL_CREDENTIALS_PATH=./secrets/google_oauth_client.json
EMAIL_AGENT_GMAIL_TOKEN_PATH=./data/gmail_token.json
EMAIL_AGENT_GMAIL_SYNC_QUERY=label:UNREAD
EMAIL_AGENT_GMAIL_SYNC_LIMIT=10

EMAIL_AGENT_OUTPUT_LANGUAGE=en
EMAIL_AGENT_LOCALE=en_US
EMAIL_AGENT_TIMEZONE=UTC
